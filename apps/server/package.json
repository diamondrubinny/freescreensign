{
  "name": "@rubinny/server",
  "version": "0.1.0",
  "private": true,
  "description": "Rubinny API and realtime server.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@rubinny/shared": "workspace:*",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  },
  "files": [
    "dist"
  ]
}
