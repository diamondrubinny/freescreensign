{
  "name": "@rubinny/server",
  "version": "0.5.0",
  "private": true,
  "description": "Rubinny API and realtime server.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "start:worker": "node dist/worker/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/lib-storage": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@node-rs/argon2": "2.2.2",
    "@rubinny/shared": "workspace:*",
    "bullmq": "6.3.15",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "nodemailer": "10.1.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "oidc-provider": "9.12.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "files": [
    "dist"
  ]
}
