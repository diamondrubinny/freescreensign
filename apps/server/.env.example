# Local development settings for the API server. Copy to .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
# The CMS dev server (Vite) runs on :5173 and proxies /api here; CSRF checks use this origin.
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://rubinny:dev@localhost:5432/rubinny
REDIS_URL=redis://localhost:6379
# false | true | comma-separated IPs/CIDRs or presets (loopback, linklocal, uniquelocal)
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# 32 bytes base64 — generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional in development; required in production.
SETUP_TOKEN=
REGISTRATION_MODE=invite
REQUIRE_EMAIL_VERIFICATION=true
# console prints emails (with secret links) to the log — development only.
MAIL_TRANSPORT=console
