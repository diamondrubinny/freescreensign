# Local development settings for the API server. Copy to .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://rubinny:dev@localhost:5432/rubinny
REDIS_URL=redis://localhost:6379
# false | true | comma-separated IPs/CIDRs or presets (loopback, linklocal, uniquelocal)
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
