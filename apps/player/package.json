{
  "name": "@rubinny/player",
  "version": "0.10.0",
  "private": true,
  "description": "Rubinny web player (offline-first PWA).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-engines.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "5.3.0",
    "@fontsource-variable/heebo": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/secular-one": "5.3.0",
    "@rubinny/shared": "workspace:*",
    "@rubinny/widget-sdk": "workspace:*",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "acorn": "8.19.0",
    "jsdom": "30.1.3",
    "vite": "8.3.4"
  }
}
