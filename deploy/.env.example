# Rubinny — Docker Compose configuration.
# Copy to .env (or run ./generate-env.sh) and fill in the values.
# Never commit the real .env file.

# Public hostname. "localhost" uses a locally-trusted certificate from Caddy;
# a real domain gets an automatic Let's Encrypt certificate (ports 80/443 must be reachable).
RUBINNY_DOMAIN=localhost

# HSTS max-age in seconds. Use 0 while testing on localhost, 31536000 in production.
HSTS_MAX_AGE=0

LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------
# Use only URL-safe characters (generate-env.sh produces hex).
POSTGRES_USER=rubinny
POSTGRES_DB=rubinny
POSTGRES_PASSWORD=change-me

# --- Object storage (SeaweedFS, S3-compatible) -------------------------------
# Allowed characters: A-Z a-z 0-9 _ + / = . -
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
