# Rubinny — Docker Compose configuration.
# Copy to .env (or run ./generate-env.sh) and fill in the values.
# Never commit the real .env file.

# Public hostname. "localhost" uses a locally-trusted certificate from Caddy;
# a real domain gets an automatic Let's Encrypt certificate (ports 80/443 must be reachable).
RUBINNY_DOMAIN=localhost

# HSTS max-age in seconds. Use 0 while testing on localhost, 31536000 in production.
HSTS_MAX_AGE=0

LOG_LEVEL=info

# --- Secrets (generate-env.sh fills these) -----------------------------------
# 32 random bytes, base64. Protects MFA secrets and pseudonymizes IPs. Back it up:
# losing it disables every user's two-factor authentication.
ENCRYPTION_KEY=change-me
# One-time token required to create the first administrator (POST /api/v1/setup).
SETUP_TOKEN=change-me

# --- Accounts ------------------------------------------------------------------
# open | invite | closed. "open" requires working outgoing mail.
REGISTRATION_MODE=invite
REQUIRE_EMAIL_VERIFICATION=true
MAX_ORGS_PER_USER=10
AUDIT_RETENTION_DAYS=365

# --- Outgoing mail -------------------------------------------------------------
# smtp | disabled. With "disabled", invitation links are shown to the admin instead.
MAIL_TRANSPORT=disabled
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=

# --- PostgreSQL ---------------------------------------------------------------
# Use only URL-safe characters (generate-env.sh produces hex).
POSTGRES_USER=rubinny
POSTGRES_DB=rubinny
POSTGRES_PASSWORD=change-me

# --- Object storage (SeaweedFS, S3-compatible) -------------------------------
# Allowed characters: A-Z a-z 0-9 _ + / = . -
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# --- Media -------------------------------------------------------------------
# Per-file limits in bytes (25 MB images, 512 MB videos) and per-organization quota (0 = unlimited).
MEDIA_MAX_IMAGE_BYTES=26214400
MEDIA_MAX_VIDEO_BYTES=536870912
MEDIA_ORG_QUOTA_BYTES=0
WORKER_CONCURRENCY=2

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
