# Rubinny reverse proxy: automatic HTTPS, security headers, CMS static files, API routing.

{$RUBINNY_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}

	# Readiness exposes dependency status; keep it on the internal network only.
	@internal path /health/ready /health/ready/*
	handle @internal {
		respond 404
	}

	@api path /api/* /player/* /health
	handle @api {
		reverse_proxy server:3000 {
			header_down -Server
		}
	}

	# Fingerprinted build assets: cache forever, never fall back to index.html.
	handle /assets/* {
		root * /srv/cms
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# CMS single-page app.
	handle {
		root * /srv/cms
		try_files {path} /index.html
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		header X-Frame-Options "DENY"
		file_server
	}
}
