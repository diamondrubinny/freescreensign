# Rubinny reverse proxy: automatic HTTPS, security headers, CMS + player static files, API.
{
	# Clients that send no server name (SNI) — some older devices, Java, IP-only requests —
	# get this site's certificate instead of a failed handshake.
	default_sni {$RUBINNY_DOMAIN:localhost}
}

{$RUBINNY_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}

	# Explicit, ordered routing (first match wins).
	route {
		# Readiness exposes dependency status; keep it on the internal network only.
		@internal path /health/ready /health/ready/*
		respond @internal 404

		# API and player API (including the player WebSocket).
		@api path /api/* /player/v1/* /health
		reverse_proxy @api server:3000 {
			header_down -Server
		}

		# Player service worker and app shell must revalidate (new versions roll out).
		@playerShell path /player /player/ /player/index.html /player/sw.js /player/manifest.webmanifest
		header @playerShell Cache-Control "no-cache"

		# Fingerprinted build assets: cache forever.
		@assets path /assets/* /player/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Player single-page app.
		@player path /player /player/*
		header @player Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' wss://{host}; frame-src https:; worker-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header @player X-Frame-Options "DENY"
		redir /player /player/ 308
		handle @player {
			root * /srv
			try_files {path} /player/index.html
			file_server
		}

		# CMS single-page app (everything else).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		header X-Frame-Options "DENY"
		header ?Cache-Control "no-cache"
		root * /srv/cms
		try_files {path} /index.html
		file_server
	}
}
