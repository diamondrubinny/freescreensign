{
  "name": "rubinny",
  "private": true,
  "description": "Rubinny \u2014 free and open-source digital signage platform",
  "license": "SEE LICENSE IN LICENSING.md",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "attribution": "node scripts/headers.mjs",
    "check": "pnpm format:check && pnpm attribution && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @rubinny/cms e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
