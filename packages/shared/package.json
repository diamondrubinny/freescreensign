{
  "name": "@rubinny/shared",
  "version": "0.8.1",
  "description": "Shared schemas and types for Rubinny (player manifest, widgets, layouts, designs, pairing, roles).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design.css": "./design.css"
  },
  "files": [
    "dist",
    "design.css",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "sideEffects": [
    "*.css"
  ]
}
